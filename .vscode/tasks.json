{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-local-debug-servers",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Stop-LocalDebugServers.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/EntraMcpMvp.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "prepare-api-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-mcp-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "mcp-inspector",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Start-McpInspector.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "mcp-inspector",
        "pattern": {
          "regexp": "^\\[inspector\\] ERROR (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[inspector\\] starting",
          "endsPattern": "^\\[inspector\\] ready"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "prepare-inspector-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build",
        "mcp-inspector"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-combined-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    }
  ]
}
