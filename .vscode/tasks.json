{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-local-debug-servers",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Stop-LocalDebugServers.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/EntraMcpMvp.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "prepare-api-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-mcp-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-combined-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "stop-local-debug-servers",
        "build"
      ],
      "problemMatcher": []
    }
  ]
}
