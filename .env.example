# Azure-Tenant/Subscription-Kontext für dieses Repo.
# Kopiere diese Datei nach ".env" und trage die echten Werte ein - ".env" ist per .gitignore
# vom Commit ausgeschlossen und darf niemals ins Git-Repo gelangen.
#
# Genutzt von scripts/Connect-Azure.ps1 (und darüber transitiv von allen anderen
# scripts/*.ps1, die Azure-Ressourcen anlegen/ändern), damit garantiert gegen den
# richtigen Tenant und die richtige Subscription gearbeitet wird.

# Entra-ID-Tenant, in dem App-Registrierungen angelegt werden (GUID oder Domain, z.B. contoso.onmicrosoft.com)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Ziel-Subscription für alle Azure-Ressourcen-Deployments (Terraform + Bicep)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Nur informativ (Anzeige in Skript-Ausgaben), keine funktionale Auswirkung
AZURE_SUBSCRIPTION_NAME=REPLACE_ME
