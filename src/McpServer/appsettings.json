{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "__REPLACE_WITH_TENANT_ID__",
    "ClientId": "__REPLACE_WITH_MCP_SERVER_APP_ID__",
    "ClientSecret": "__SET_VIA_KEYVAULT_REFERENCE_OR_USER_SECRETS__",
    "Audience": "api://__REPLACE_WITH_MCP_SERVER_NAME__",
    "ApiAppIdUri": "api://__REPLACE_WITH_API_SERVER_NAME__",
    "UseManagedIdentity": true
  },
  "McpAuth": {
    "ExternalBaseUrl": "https://__REPLACE_WITH_MCP_SERVER_HOSTNAME__.azurewebsites.net",
    "Scope": "api://__REPLACE_WITH_MCP_SERVER_NAME__/Mcp.Access",
    "ApiKey": "",
    "RequireAuthentication": true
  },
  "ApiServer": {
    "BaseUrl": "https://__REPLACE_WITH_API_SERVER_HOSTNAME__.azurewebsites.net"
  }
}
